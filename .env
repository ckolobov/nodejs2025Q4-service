# Application
PORT=4000

# Application security
CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# Database (PostgreSQL)
POSTGRES_DB=home_library
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=database
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=home_library

# Prisma
# For Docker: use DB_HOST=database
# For local dev: use DB_HOST=localhost
DATABASE_URL="postgresql://postgres:postgres@database:5432/home_library?schema=public"